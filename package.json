{
  "name": "multi-agent-ai-dev-assistant",
  "version": "1.0.0",
  "description": "Production-ready Multi-Agent AI Developer Assistant",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec node --experimental-modules server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "echo 'Server ready'",
    "build:client": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "mongoose": "^8.0.0",
    "openai": "^4.24.0",
    "socket.io": "^4.7.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "bull": "^4.11.5",
    "redis": "^4.6.12"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "eslint": "^8.54.0"
  }
}
